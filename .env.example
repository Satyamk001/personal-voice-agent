# ── API Keys (set at least one LLM key + Tavily) ──
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

# Required: Tavily Search API key (from https://tavily.com)
TAVILY_API_KEY=tvly-...

# ── LLM Provider & Fallback Chain ──
# Primary provider tried first. On rate-limit (429) or transient errors,
# the next provider in the chain is tried automatically.
LLM_PROVIDER=groq
LLM_FALLBACK_CHAIN=groq,openrouter,gemini

# Per-provider default models (used when that provider is active)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash

# ── Speech-to-Text ──
# Groq Whisper is fast and free; Gemini multimodal is the fallback
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_CHAIN=groq,gemini

# ── Text-to-Speech ──
# edge-tts is 100% free (Microsoft Neural TTS). Alternative: "openai"
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-AriaNeural

# Optional: OpenAI API key (if you want to add OpenAI to the chain)
# OPENAI_API_KEY=sk-...

# Optional: LangSmith observability (tracing of every agent/tool call).
# Leave unset to run with tracing off. Get a key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=voice-agent-demo

# Gmail and Notion are NOT configured here - both are reached over MCP and
# authenticate themselves via a token cached on disk by a one-time setup
# command. See README.md / tutorial.md for the exact steps:
#   Gmail:  npx @gongrzhe/server-gmail-autoauth-mcp auth
#   Notion: npx -y mcp-remote https://mcp.notion.com/mcp

# Optional: protect webapp/ with HTTP Basic Auth (the browser's native
# login prompt). Leave AUTH_PASSWORD unset to run the web demo with no
# login, e.g. for local development. Required before deploying publicly.
# AUTH_USERNAME=demo
# AUTH_PASSWORD=
