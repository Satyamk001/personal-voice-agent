# Required: Google Gemini API key (from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Required: Tavily Search API key (from https://tavily.com)
TAVILY_API_KEY=tvly-...

# Core LLM provider and model settings
LLM_PROVIDER=gemini
CHAT_MODEL=gemini-3.8-flash

# Speech-to-Text: "gemini" (default, multimodal audio transcription), "groq" (free Whisper), or "openai"
STT_PROVIDER=gemini
STT_MODEL=gemini-3.8-flash

# Text-to-Speech: "edge-tts" (default, 100% free neural voice, no key needed) or "openai"
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-AriaNeural

# Optional: Groq API key for ultra-fast whisper-large-v3-turbo or open LLMs (from https://console.groq.com)
# GROQ_API_KEY=gsk_...

# Optional: OpenAI API key (if you want to use OpenAI models instead)
# OPENAI_API_KEY=sk-...

# Optional: LangSmith observability (tracing of every agent/tool call).
# Leave unset to run with tracing off. Get a key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=voice-agent-demo

# Gmail and Notion are NOT configured here - both are reached over MCP and
# authenticate themselves via a token cached on disk by a one-time setup
# command. See README.md / tutorial.md for the exact steps:
#   Gmail:  npx @gongrzhe/server-gmail-autoauth-mcp auth
#   Notion: npx -y mcp-remote https://mcp.notion.com/mcp

# Optional: protect webapp/ with HTTP Basic Auth (the browser's native
# login prompt). Leave AUTH_PASSWORD unset to run the web demo with no
# login, e.g. for local development. Required before deploying publicly.
# AUTH_USERNAME=demo
# AUTH_PASSWORD=
